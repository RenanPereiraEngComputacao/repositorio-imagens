    </main>
  </div>
  <div class="toast-region" data-toasts aria-live="polite" aria-atomic="false"></div>
  <dialog class="dialog" data-confirm-dialog aria-labelledby="confirm-title">
    <form method="dialog">
      <div class="dialog-body">
        <h2 id="confirm-title" data-confirm-title>Confirmar</h2>
        <p class="muted" data-confirm-message></p>
      </div>
      <div class="dialog-actions">
        <button class="btn btn-ghost" value="cancel" type="submit">Cancelar</button>
        <button class="btn btn-danger" value="ok" type="submit" data-confirm-ok>Confirmar</button>
      </div>
    </form>
  </dialog>
  <script src="/assets/admin.js" defer></script>
</body>
</html>
