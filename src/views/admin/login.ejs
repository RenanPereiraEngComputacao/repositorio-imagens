<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> · <%= brand %> Imagens</title>
  <link rel="stylesheet" href="/assets/styles.css">
</head>
<body class="login-body">
  <section class="login-visual" aria-hidden="true">
    <div>
      <span class="wordmark"><%= brand %></span>
      <span class="wordmark-sub">Acervo de imagens</span>
    </div>
    <p class="login-quote">Cada peça, com a imagem que ela merece.</p>
  </section>
  <main class="login-panel">
    <form class="login-form" action="/admin/login" method="post">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <p class="eyebrow">Área restrita</p>
        <h1>Entrar no painel</h1>
      </div>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error" role="alert"><%- icon('alert') %><div><%= error %></div></div>
      <% } %>
      <label class="field">
        <span>Usuário</span>
        <input class="input" name="username" autocomplete="username" value="<%= typeof username !== 'undefined' ? username : '' %>" required autofocus>
      </label>
      <label class="field">
        <span>Senha</span>
        <input class="input" name="password" type="password" autocomplete="current-password" required>
      </label>
      <button class="btn btn-primary btn-block" type="submit">Entrar</button>
    </form>
  </main>
</body>
</html>
