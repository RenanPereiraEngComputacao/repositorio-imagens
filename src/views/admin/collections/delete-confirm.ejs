<%- include('../../partials/admin/start') %>
<header class="page-head">
  <div>
    <a class="back-link" href="/admin/collections/<%= impact.id %>/excluir"><%- icon('arrow-left') %> Voltar ao impacto</a>
    <h1>Confirmar exclusão</h1>
  </div>
</header>

<section class="card card-narrow danger-zone">
  <div class="card-head"><h2>Última etapa</h2></div>
  <form class="card-body form-stack" action="/admin/collections/<%= impact.id %>/excluir" method="post" autocomplete="off" data-phrase-form>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="intent" value="<%= intent.token %>">
    <div class="steps" aria-label="Etapas"><span>1 · Impacto</span><span aria-hidden="true">—</span><span aria-current="step">2 · Confirmação</span></div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error" role="alert"><%- icon('alert') %><div><%= error %></div></div>
    <% } %>

    <p>Você vai excluir <strong><%= impact.name %></strong> com <strong><%= plural(impact.products_count, 'produto', 'produtos') %></strong> e <strong><%= plural(impact.images_count, 'imagem', 'imagens') %></strong>.</p>

    <label class="field">
      <span>Para confirmar, digite: <span class="phrase" data-phrase><%= phrase %></span></span>
      <input class="input input-mono" name="phrase" required autocomplete="off" autocapitalize="off" spellcheck="false" data-phrase-input aria-describedby="phrase-hint">
      <span class="field-hint" id="phrase-hint">A confirmação expira em 10 minutos e só pode ser usada uma vez.</span>
    </label>

    <div class="form-actions">
      <a class="btn btn-ghost" href="/admin/collections">Cancelar</a>
      <button class="btn btn-danger" type="submit" data-phrase-submit><%- icon('trash') %> Excluir coleção</button>
    </div>
  </form>
</section>
<%- include('../../partials/admin/end') %>
