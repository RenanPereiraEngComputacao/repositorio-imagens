{
  "name": "malagah-repositorio-imagens",
  "version": "2.0.0",
  "private": true,
  "description": "MÁLAGAH — repositório web de imagens de produtos acessadas por referência via QR Code.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:status": "node scripts/migrate.js --status",
    "admin:hash": "node scripts/create-admin-hash.js",
    "images:derivatives": "node scripts/generate-derivatives.js",
    "trash:list": "node scripts/trash.js list",
    "trash:restore": "node scripts/trash.js restore",
    "trash:purge": "node scripts/trash.js purge",
    "test": "node --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^2.0.2",
    "pg": "^8.13.1",
    "sharp": "^0.33.5",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "adm-zip": "^0.6.1",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
